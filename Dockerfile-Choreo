FROM calciumion/new-api:latest

USER root

RUN set -eux; \
    if command -v apt-get >/dev/null 2>&1; then \
        apt-get update; \
        apt-get install -y --no-install-recommends \
            sqlite3 \
            restic \
            ca-certificates \
            tzdata; \
        rm -rf /var/lib/apt/lists/*; \
    elif command -v apk >/dev/null 2>&1; then \
        apk add --no-cache \
            sqlite \
            restic \
            ca-certificates \
            tzdata; \
    else \
        echo "Unsupported base image: no apt-get or apk found"; \
        exit 1; \
    fi

COPY backup-sqlite-r2.sh /usr/local/bin/backup-sqlite-r2.sh

RUN chmod 755 /usr/local/bin/backup-sqlite-r2.sh

ENV TMPDIR=/tmp
ENV HOME=/tmp
ENV XDG_CACHE_HOME=/tmp/.cache
ENV RESTIC_CACHE_DIR=/tmp/restic-cache

ENV DB_PATH=/data/newapi/one-api.db
ENV BACKUP_NAME=one-api

ENV TZ=Asia/Shanghai

# 默认每天备份一次，如果设置 BACKUP_TIME，则按固定时间备份
ENV INTERVAL_SECONDS=86400

# 最多保留最近 5 份备份
ENV KEEP_LAST=5

# 容器每次启动/重启时，从远程恢复最新备份并覆盖本地数据库
ENV RESTORE_ON_START=1

USER 10014

ENTRYPOINT ["/usr/local/bin/backup-sqlite-r2.sh"]
