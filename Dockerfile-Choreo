FROM calciumion/new-api:latest

USER root

RUN set -eux; \
    if command -v apt-get >/dev/null 2>&1; then \
        apt-get update; \
        apt-get install -y --no-install-recommends \
            sqlite3 \
            restic \
            ca-certificates \
            tzdata; \
        rm -rf /var/lib/apt/lists/*; \
    elif command -v apk >/dev/null 2>&1; then \
        apk add --no-cache \
            sqlite \
            restic \
            ca-certificates \
            tzdata; \
    else \
        echo "Unsupported base image: no apt-get or apk found"; \
        exit 1; \
    fi

COPY backup-sqlite-r2.sh /usr/local/bin/backup-sqlite-r2.sh

RUN chmod 755 /usr/local/bin/backup-sqlite-r2.sh

# =========================
# 默认配置
# =========================

ENV TZ=Asia/Shanghai

ENV TMPDIR=/tmp
ENV HOME=/tmp
ENV XDG_CACHE_HOME=/tmp/.cache
ENV RESTIC_CACHE_DIR=/tmp/restic-cache

ENV DB_PATH=/data/newapi/one-api.db
ENV BACKUP_NAME=one-api
ENV BACKUP_DIR=/tmp/sqlite-backup

# 容器启动时是否自动从 R2 恢复最新数据库
ENV RESTORE_ON_START=1
ENV RESTORE_REQUIRED=0
ENV RESTORE_ONLY=0

# restic 仓库初始化默认关闭
ENV RESTIC_INIT=0

# 自动清理旧备份
ENV RESTIC_FORGET=1
ENV KEEP_LAST=3

ENV RESTIC_HOST=new-api

ENV RUN_ONCE=0
ENV RUN_IMMEDIATELY=0

ENV AWS_REGION=auto
ENV AWS_DEFAULT_REGION=auto

# =========================
# 必要配置：备份时间 / 间隔时间
# =========================

# 每天固定时间备份，格式 HH:MM
# 如果要使用间隔模式，可以改成空：ENV BACKUP_TIME=
ENV BACKUP_TIME=03:00

# 间隔备份秒数
# 当 BACKUP_TIME 为空时生效
ENV INTERVAL_SECONDS=86400

# =========================
# 必要配置：Cloudflare R2 / restic
# =========================

# 修改为你的 R2 仓库地址
# 格式：
# s3:https://你的AccountID.r2.cloudflarestorage.com/你的Bucket/newapi
ENV RESTIC_REPOSITORY=s3:https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com/CHANGE_ME_BUCKET/newapi

# 修改为你的 restic 仓库密码
ENV RESTIC_PASSWORD=CHANGE_ME_RESTIC_PASSWORD

# 修改为你的 R2 API Key
ENV AWS_ACCESS_KEY_ID=CHANGE_ME_R2_ACCESS_KEY_ID
ENV AWS_SECRET_ACCESS_KEY=CHANGE_ME_R2_SECRET_ACCESS_KEY

USER 10014

ENTRYPOINT ["/usr/local/bin/backup-sqlite-r2.sh"]
